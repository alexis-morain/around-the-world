---
/* Ancienne fiche film : redirige vers la fiche pays, en gardant l'éventuel #ancre. */
import Redirect from "../../components/Redirect.astro";
import { films } from "../../lib/films";
import { countrySlug } from "../../lib/logic";
import { href } from "../../lib/i18n";
export function getStaticPaths() {
  return films.map((film) => ({ params: { iso: film.iso2.toLowerCase() }, props: { iso: film.iso2 } }));
}
const { iso } = Astro.props as { iso: string };
---
<Redirect to={href("fr", countrySlug("fr", iso))} />
