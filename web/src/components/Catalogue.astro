---
/* Tout le catalogue en trois onglets (films, livres, séries) : grilles rendues au build, filtrées et triées dans le navigateur. L'état vit dans l'URL. */
import Icon from "./Icon.astro";
import { cardHtml } from "../lib/cards";
import { CONTINENTS, cardData, countryName, itemOf, langName, films, withBook, withFilm, withSeries } from "../lib/films";
import { KINDS, SORTS, type Kind, type Lang } from "../lib/logic";
import { t } from "../lib/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = t(lang);
const C = L.catalogue;
const col = new Intl.Collator(lang);
const byCountry = (a: { iso2: string }, b: { iso2: string }) => col.compare(countryName(a.iso2, lang), countryName(b.iso2, lang));
const lists: Record<Kind, typeof films> = { film: [...withFilm].sort(byCountry), book: [...withBook].sort(byCountry), series: [...withSeries].sort(byCountry) };
const items = Object.fromEntries(KINDS.map((k) => [k, lists[k].map((f) => itemOf(f, k, lang))])) as Record<Kind, ReturnType<typeof itemOf>[]>;

// décennies et langues de chaque type : les langues d'au moins deux œuvres, le reste se trouve par la recherche
const decades = Object.fromEntries(KINDS.map((k) => [k, [...new Set(items[k].map((i) => i.year).filter((y): y is number => !!y).map((y) => Math.floor(y / 10) * 10))].sort((a, b) => a - b)])) as Record<Kind, number[]>;
const langs = Object.fromEntries(KINDS.map((k) => {
  const counts = new Map<string, number>();
  for (const i of items[k]) if (i.lang) counts.set(i.lang, (counts.get(i.lang) || 0) + 1);
  return [k, [...counts].filter(([, n]) => n >= 2).map(([c]) => [c, langName(c, lang)] as const).sort((a, b) => col.compare(a[1], b[1]))];
})) as Record<Kind, (readonly [string, string])[]>;
const decadeLabel = (d: number) => (lang === "fr" ? `Années ${d}` : `${d}s`);
const client = { sorts: Object.fromEntries(KINDS.map((k) => [k, SORTS[k].map((s) => [s, C.sorts[k][s]])])), counts: C.count, decades: Object.fromEntries(KINDS.map((k) => [k, decades[k].map((d) => [d, decadeLabel(d)])])), langs };
---
<div class="page-head">
  <h1 class="display">{C.title}</h1>
  <p>{C.lede(items.film.length, items.book.length, items.series.length)}</p>
</div>
<div class="tabs" role="tablist" aria-label={C.tabs}>
  {KINDS.map((k, i) => (
    <button type="button" role="tab" id={`tab-${k}`} aria-controls={`panel-${k}`} aria-selected={i === 0 ? "true" : "false"} data-tab={k}>{L.kind[k].plural}<span class="n">{items[k].length}</span></button>
  ))}
</div>
<form class="filters" id="filters" role="search" aria-label={C.filters}>
  <div class="f-line">
    <label class="field"><span class="visually-hidden">{C.search}</span><Icon name="search" /><input class="input" type="search" name="q" placeholder={C.search} autocomplete="off" spellcheck="false" /></label>
    <label class="visually-hidden" for="f-continent">{C.anyContinent}</label>
    <select class="select" name="continent" id="f-continent"><option value="">{C.anyContinent}</option>{CONTINENTS.map((c) => <option value={c}>{L.continents[c]}</option>)}</select>
    <label class="visually-hidden" for="f-decade">{C.anyDecade}</label>
    <select class="select" name="decade" id="f-decade"><option value="">{C.anyDecade}</option>{decades.film.map((d) => <option value={d}>{decadeLabel(d)}</option>)}</select>
    <label class="visually-hidden" for="f-duration">{C.anyDuration}</label>
    <select class="select" name="duration" id="f-duration" data-only="film"><option value="">{C.anyDuration}</option>{Object.entries(C.durations).map(([k, v]) => <option value={k}>{v}</option>)}</select>
    <label class="visually-hidden" for="f-lang">{C.anyLang}</label>
    <select class="select" name="lang" id="f-lang" data-lang-select><option value="">{C.anyLang}</option>{langs.film.map(([c, n]) => <option value={c}>{n}</option>)}</select>
    <label class="visually-hidden" for="f-level">{C.anyLevel}</label>
    <select class="select" name="level" id="f-level"><option value="">{C.anyLevel}</option>{["A", "B", "C", "D"].map((l) => <option value={l}>{l} · {C.levelShort[l]}</option>)}</select>
    <label class="sort">{C.sort}
      <select class="select" name="sort" id="f-sort">{SORTS.film.map((s) => <option value={s}>{C.sorts.film[s]}</option>)}</select>
    </label>
  </div>
  <div class="f-line">
    <label class="chip" data-only="film"><input type="checkbox" name="fr" value="1" /><span>{C.fr}</span></label>
    <label class="chip" data-only="film"><input type="checkbox" name="anim" value="1" /><span>{C.anim}</span></label>
    <label class="chip"><input type="checkbox" name="unseen" value="1" /><span>{C.unseen}</span></label>
    <label class="chip"><input type="checkbox" name="list" value="1" /><span>{C.list}</span></label>
    <button type="reset" class="link-btn">{C.reset}</button>
  </div>
</form>
<p class="count" id="count" aria-live="polite">{C.count.film[2].replace("{n}", String(items.film.length))}</p>
{KINDS.map((k) => (
  <div role="tabpanel" id={`panel-${k}`} aria-labelledby={`tab-${k}`} data-panel={k}>
    <h2 class="visually-hidden">{L.kind[k].plural}</h2>
    <ul class="grid" data-grid={k}>
      {lists[k].map((f, i) => <li set:html={cardHtml(cardData(f, k, lang)!, lang, { item: items[k][i] })} />)}
    </ul>
  </div>
))}
<script id="cat-data" type="application/json" set:html={JSON.stringify(client)} />
