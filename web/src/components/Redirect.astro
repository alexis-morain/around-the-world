---
/* Page de redirection statique : meta refresh, canonical, et le #ancre est reporté par un script. */
interface Props { to: string; lang?: "fr" | "en" }
const { to, lang = "fr" } = Astro.props;
const abs = new URL(to, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <title>Around the World</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={abs} />
  <meta http-equiv="refresh" content={`0; url=${to}`} />
  <script is:inline define:vars={{ to }}>location.replace(to + location.hash);</script>
</head>
<body><p><a href={to}>{to}</a></p></body>
</html>
