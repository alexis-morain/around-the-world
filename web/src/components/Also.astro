---
/* Le livre et la série du pays, sous le film : de quoi prolonger la soirée. */
import type { Film } from "../lib/films";
import { byAuthor, isThin, wikiUrl, workTitle, type Lang } from "../lib/logic";
import { t } from "../lib/i18n";

interface Props { film: Film; lang: Lang }
const { film: f, lang } = Astro.props;
const L = t(lang);
const b = f.book;
const s = f.series;
const author = b ? (lang === "fr" ? b.author : b.author_en) : "";
const bookMeta = b ? [author && byAuthor(author, lang), b.year].filter(Boolean).join(" · ") : "";
const bookTitle = b ? workTitle(b, lang) : "";
const seriesTitle = s ? workTitle(s, lang) : "";
---
{(b || s) && (
  <section class="also" aria-labelledby={`also-${f.iso2}`}>
    <h2 id={`also-${f.iso2}`}>{L.also}</h2>
    <ul class="also-list">
      {b && (
        <li>
          <span class="also-kind">{L.alsoBook}</span>
          <a class="also-title" href={wikiUrl(b.qid, lang)} target="_blank" rel="noopener">{bookTitle}</a>
          <span class="also-meta">
            {bookMeta}
            {b.orig && b.orig !== bookTitle && <>{bookMeta && " · "}<i>{b.orig}</i></>}
          </span>
          {isThin("book", b.links) && <span class="also-thin">{L.thin}</span>}
        </li>
      )}
      {s && (
        <li>
          <span class="also-kind">{L.alsoSeries}</span>
          <a class="also-title" href={`https://www.themoviedb.org/tv/${s.tmdb_id}`} target="_blank" rel="noopener">{seriesTitle}</a>
          <span class="also-meta">
            {s.year}
            {s.orig && s.orig !== seriesTitle && <>{s.year && " · "}<i lang={s.lang}>{s.orig}</i></>}
          </span>
          {isThin("series", s.votes) && <span class="also-thin">{L.thin}</span>}
        </li>
      )}
    </ul>
    <p class="muted small">{L.alsoHow}</p>
  </section>
)}
