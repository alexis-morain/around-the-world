---
/* Une affiche cliquable. Les data-* servent au catalogue (filtres, tri) et aux marques « vu » et « ma liste ». */
import Poster from "./Poster.astro";
import { countryName, itemOf, localTitle, type Film } from "../lib/films";
import type { Lang } from "../lib/logic";
import { href, t } from "../lib/i18n";

interface Props { film: Film; lang: Lang; data?: boolean }
const { film: f, lang, data = false } = Astro.props;
const L = t(lang);
const it = itemOf(f, lang);
const attrs = data ? {
  "data-country": it.country, "data-title": it.title, "data-alt": it.alt, "data-year": it.year ?? "",
  "data-runtime": it.runtime ?? "", "data-level": it.level, "data-continent": it.continent, "data-lang": it.lang,
  "data-anim": it.anim ? "1" : "", "data-fr": it.fr ? "1" : "", "data-imdb": it.imdb ?? "", "data-rt": it.rt ?? "",
} : {};
---
<a class="card" href={href(lang, `film/${f.iso2.toLowerCase()}/`)} data-iso={f.iso2} {...attrs}>
  <Poster film={f} lang={lang} size="w342">
    <span class="card-tags"><span class="tag seen">{L.seenOn}</span><span class="tag list">{L.rows.list}</span></span>
  </Poster>
  <span class="card-cty">{countryName(f.iso2, lang)}</span>
  <span class="card-ttl">{localTitle(f, lang)}</span>
</a>
