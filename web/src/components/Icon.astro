---
/* Icônes au trait, 20 × 20, dessinées pour le site. */
interface Props { name: "play" | "plus" | "check" | "eye" | "shuffle" | "info" | "link" | "close" | "left" | "right" | "search" | "sun" | "moon"; class?: string }
const { name, class: cls = "" } = Astro.props;
const paths: Record<string, string> = {
  play: '<path d="M6.5 4.2v11.6L16 10z" fill="currentColor" stroke="none"/>',
  plus: '<path d="M10 4v12M4 10h12"/>',
  check: '<path d="M4.5 10.5l3.6 3.6L15.8 6"/>',
  eye: '<path d="M2 10s3-5.5 8-5.5S18 10 18 10s-3 5.5-8 5.5S2 10 2 10z"/><circle cx="10" cy="10" r="2.4"/>',
  shuffle: '<path d="M3 6h2.6c1.6 0 2.6.8 3.5 2.2l2 3.6c.8 1.4 1.9 2.2 3.5 2.2H17M3 14h2.6c1 0 1.7-.3 2.3-.9M12.2 6.9c.6-.6 1.3-.9 2.3-.9H17M14.6 3.6L17 6l-2.4 2.4M14.6 11.6L17 14l-2.4 2.4"/>',
  info: '<circle cx="10" cy="10" r="7.2"/><path d="M10 9v4.6M10 6.4v.1"/>',
  link: '<path d="M8.4 11.6a3.3 3.3 0 0 0 4.7 0l2.6-2.6a3.3 3.3 0 0 0-4.7-4.7l-.9.9M11.6 8.4a3.3 3.3 0 0 0-4.7 0L4.3 11a3.3 3.3 0 0 0 4.7 4.7l.9-.9"/>',
  close: '<path d="M5 5l10 10M15 5L5 15"/>',
  left: '<path d="M12.5 4.5L7 10l5.5 5.5"/>',
  right: '<path d="M7.5 4.5L13 10l-5.5 5.5"/>',
  search: '<circle cx="8.8" cy="8.8" r="5.3"/><path d="M12.8 12.8L17 17"/>',
  sun: '<circle cx="10" cy="10" r="3.4"/><path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M4.7 15.3l1.4-1.4M13.9 6.1l1.4-1.4"/>',
  moon: '<path d="M16.2 12.2A6.8 6.8 0 0 1 7.8 3.8a6.8 6.8 0 1 0 8.4 8.4z"/>',
};
---
<svg class={`icon i-${name} ${cls}`} viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />
