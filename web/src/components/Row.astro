---
/* Rangée horizontale. `cards` : le HTML de chaque élément. `client` : rangée remplie dans le navigateur (ma liste, œuvres vues). */
import Icon from "./Icon.astro";
import type { Lang } from "../lib/logic";
import { t } from "../lib/i18n";

interface Props { id: string; title: string; cards: string[]; lang: Lang; more?: string; client?: string; tiles?: boolean }
const { id, title, cards, lang, more, client, tiles = false } = Astro.props;
const L = t(lang);
---
<section class:list={["row", { "row-tiles": tiles }]} id={id} aria-labelledby={`${id}-h`} data-client-row={client} hidden={client ? true : undefined}>
  <div class="row-head">
    <h2 id={`${id}-h`}>{title}</h2>
    <span class="n">{cards.length || ""}</span>
    {more && <a href={more}>{L.rowAll}</a>}
  </div>
  <div class="rail">
    <button class="rail-btn prev" type="button" aria-label={L.prev} tabindex="-1" disabled><Icon name="left" /></button>
    <ul class="track">
      {cards.map((c) => <li set:html={c} />)}
    </ul>
    <button class="rail-btn next" type="button" aria-label={L.next} tabindex="-1"><Icon name="right" /></button>
  </div>
</section>
