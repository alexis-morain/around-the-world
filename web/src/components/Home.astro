---
/* Accueil : le pays du jour avec ses trois œuvres, la carte, puis des rangées. Le pays du jour est rendu au build puis remplacé par celui du visiteur. */
import Row from "./Row.astro";
import Icon from "./Icon.astro";
import { cardHtml, tileHtml, trioHtml } from "../lib/cards";
import { CONTINENTS, cardData, clientIndex, countryName, films, onSubscription, withBook, withFilm, withSeries } from "../lib/films";
import { KINDS, nameLen, pickDaily, type Lang } from "../lib/logic";
import { href, t } from "../lib/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = t(lang);
const col = new Intl.Collator(lang);
const index = clientIndex(lang);
const byName = (a: { name: string }, b: { name: string }) => col.compare(a.name, b.name);

// Le pays du jour : un pays qui a ses trois œuvres, pour que la rangée soit pleine.
const full = index.filter((c) => KINDS.every((k) => c.works[k])).map((c) => c.iso);
const pool = full.length >= 20 ? full : index.filter((c) => Object.keys(c.works).length).map((c) => c.iso);
const dayIso = pickDaily(pool, new Set(), new Date())!;
const day = index.find((c) => c.iso === dayIso)!;

const cardsOf = (list: typeof films, kind: (typeof KINDS)[number]) => list.map((f) => cardHtml(cardData(f, kind, lang)!, lang));
const topFilms = withFilm.filter((f) => (f.ratings?.imdb?.votes ?? 0) >= 1000).sort((a, b) => b.ratings!.imdb!.value - a.ratings!.imdb!.value).slice(0, 24);
const topBooks = [...withBook].sort((a, b) => b.book!.links - a.book!.links).slice(0, 24);
const topSeries = [...withSeries].sort((a, b) => b.series!.votes - a.series!.votes).slice(0, 24);
const france = withFilm.filter(onSubscription).sort((a, b) => col.compare(countryName(a.iso2, lang), countryName(b.iso2, lang)));
const continents = CONTINENTS.map((c) => [c, index.filter((x) => x.continent === c && Object.keys(x.works).length).sort(byName)] as const).filter(([, l]) => l.length);
const cat = (q: string) => href(lang, `catalogue/${q}`);
---
<h1 class="visually-hidden">{L.brand} : {L.tagline}</h1>
<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="hero-text" id="hero-text">
    <p class="hero-kicker"><span class="rule" aria-hidden="true"></span><span data-hero-kicker>{L.daily}</span></p>
    <h2 class="hero-title display" id="hero-title" data-len={nameLen(day.name)}>{day.name}</h2>
    <p class="hero-sub" id="hero-sub">{L.continents[day.continent]}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={href(lang, `${lang === "fr" ? "pays" : "country"}/${day.iso.toLowerCase()}/`)} data-iso={day.iso} data-open id="hero-open"><Icon name="info" />{L.more}</a>
      <button class="btn btn-ghost" type="button" id="random"><Icon name="shuffle" />{L.random}</button>
    </div>
  </div>
  <ul class="trio" id="trio" aria-label={L.trioLabel} set:html={trioHtml(day, lang, true)} />
  <div class="leader" id="leader" aria-hidden="true" hidden>
    <div class="leader-disc"><span class="leader-num" id="leader-num">3</span></div>
  </div>
</section>

<section class="map-section wrap" id="carte" aria-labelledby="map-h">
  <div class="section-head">
    <h2 id="map-h">{L.mapTitle}</h2>
    <p>{L.mapHint}</p>
  </div>
  <div class="map-modes" role="group" aria-label={L.mapModes}>
    {["film", "book", "series", "all"].map((m) => <button type="button" data-mode={m} aria-pressed={m === "film" ? "true" : "false"}>{L.mapMode[m]}</button>)}
  </div>
  <div class="screen" id="screen">
    <svg id="map" role="img" aria-label={L.mapLabel}></svg>
    <ul class="map-key" id="map-key" aria-hidden="true" data-labels={JSON.stringify({ open: L.mapKeyOpen, seen: L.mapKeySeen, some: [1, 2, 3].map(L.mapKeySome), none: L.mapKeyNone })}></ul>
    <div class="map-tools">
      <button type="button" id="zoom-in" aria-label={L.zoomIn}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10"/></svg></button>
      <button type="button" id="zoom-out" aria-label={L.zoomOut}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10"/></svg></button>
      <button type="button" id="zoom-reset">{L.reset}</button>
    </div>
    <div class="tip" id="tip" hidden></div>
    <p class="map-status" id="map-status">{L.mapLoading}</p>
  </div>
</section>

<div class="rows">
  <Row id="row-list" title={L.rows.list} cards={[]} lang={lang} client="list" more={cat("?list=1")} />
  <Row id="row-films" title={L.rows.films} cards={cardsOf(topFilms, "film")} lang={lang} more={cat("?sort=imdb")} />
  <Row id="row-books" title={L.rows.books} cards={cardsOf(topBooks, "book")} lang={lang} more={cat("?tab=book&sort=pop")} />
  <Row id="row-series" title={L.rows.series} cards={cardsOf(topSeries, "series")} lang={lang} more={cat("?tab=series&sort=pop")} />
  {continents.map(([c, l]) => <Row id={`row-${c}`} title={L.continents[c]} cards={l.map((x) => tileHtml(x, lang))} lang={lang} tiles more={cat(`?continent=${c}`)} />)}
  <Row id="row-france" title={L.rows.france} cards={cardsOf(france, "film")} lang={lang} more={cat("?fr=1")} />
  <Row id="row-seen" title={L.rows.seen} cards={[]} lang={lang} client="seen" />
</div>

<script id="index" type="application/json" set:html={JSON.stringify({ countries: index, pool, continents: L.continents })} />
